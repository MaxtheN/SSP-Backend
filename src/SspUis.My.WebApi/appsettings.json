{
  "Culture": {
    "DefaultCulture": "ru"
  },
  "ExceptionMiddleware": {
    "WriteToDb": true,
    "IncludeBody": true
  },

  "ClientErrors": {
    "Enabled": true,
    "SentErrorDetails": true
  },
  "ControllerConfig": {
    "EnableSecurityInfo": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}